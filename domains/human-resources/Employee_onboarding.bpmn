<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_Onboarding" targetNamespace="https://example.com/spiffarena/templates/onboarding">
  <bpmn:process id="Process_EmployeeOnboarding_1768881387" name="Employee Onboarding" isExecutable="true">
    <bpmn:laneSet id="LaneSet_Onboarding">
      <bpmn:lane id="Lane_HR" name="HR">
        <bpmn:flowNodeRef>Task_SendWelcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Onboarding</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CaptureDetails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start_Onboarding</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Manager" name="Manager">
        <bpmn:flowNodeRef>Task_ManagerApprove</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyRejection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IT" name="IT / Shared Services">
        <bpmn:flowNodeRef>Task_CreateAccounts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProvisionLaptop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BoundaryTimer_Accounts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ForkProvisioning</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EscalateProvisioning</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BoundaryTimer_Laptop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_JoinProvisioning</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SetupPayroll</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BoundaryTimer_Payroll</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Onboarding" name="New Hire Created" />
    <bpmn:userTask id="Task_CaptureDetails" name="Capture Employee Details">
      <bpmn:documentation>HR captures name, role, start_date, manager, department, location.</bpmn:documentation>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ManagerApprove" name="Manager Approval">
      <bpmn:documentation>Manager approves onboarding request.</bpmn:documentation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Approved" name="Approved?" />
    <bpmn:userTask id="Task_NotifyRejection" name="Notify Rejection">
      <bpmn:documentation>Notify HR + requester; close case.</bpmn:documentation>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Rejected" name="Rejected" />
    <bpmn:parallelGateway id="Gateway_ForkProvisioning" name="Provision in Parallel" />
    <bpmn:serviceTask id="Task_CreateAccounts" name="Create Accounts">
      <bpmn:documentation>Service Task: Use SpiffArena connector (e.g., Google/Okta) to provision accounts.</bpmn:documentation>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="BoundaryTimer_Accounts" name="Accounts SLA" cancelActivity="false" attachedToRef="Task_CreateAccounts">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>PT24H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Task_ProvisionLaptop" name="Provision Laptop">
      <bpmn:documentation>Service/User Task: Create asset ticket in ITSM; track shipment.</bpmn:documentation>
      <bpmn:incoming>Flow_O_Pay</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="BoundaryTimer_Laptop" name="Laptop SLA" cancelActivity="false" attachedToRef="Task_ProvisionLaptop">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>P2D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Task_SetupPayroll" name="Setup Payroll">
      <bpmn:documentation>Service Task: Create payroll profile in HRIS.</bpmn:documentation>
      <bpmn:incoming>Flow_O_Lap</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="BoundaryTimer_Payroll" name="Payroll SLA" cancelActivity="false" attachedToRef="Task_SetupPayroll">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>P1D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:userTask id="Task_EscalateProvisioning" name="Escalate Provisioning">
      <bpmn:documentation>Triggered by SLA timers; notify IT lead/manager and re-prioritize.</bpmn:documentation>
    </bpmn:userTask>
    <bpmn:parallelGateway id="Gateway_JoinProvisioning" name="All Provisioned" />
    <bpmn:serviceTask id="Task_SendWelcome" name="Send Welcome Email">
      <bpmn:documentation>Service Task: Send welcome email with first-day instructions.</bpmn:documentation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Onboarding" name="Onboarding Complete" />
    <bpmn:sequenceFlow id="Flow_O_1" sourceRef="Start_Onboarding" targetRef="Task_CaptureDetails" />
    <bpmn:sequenceFlow id="Flow_O_2" sourceRef="Task_CaptureDetails" targetRef="Task_ManagerApprove" />
    <bpmn:sequenceFlow id="Flow_O_3" sourceRef="Task_ManagerApprove" targetRef="Gateway_Approved" />
    <bpmn:sequenceFlow id="Flow_O_Reject" sourceRef="Gateway_Approved" targetRef="Task_NotifyRejection">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">approved == false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_O_RejectEnd" sourceRef="Task_NotifyRejection" targetRef="End_Rejected" />
    <bpmn:sequenceFlow id="Flow_O_Approve" sourceRef="Gateway_Approved" targetRef="Gateway_ForkProvisioning">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">approved == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_O_Acct" sourceRef="Gateway_ForkProvisioning" targetRef="Task_CreateAccounts" />
    <bpmn:sequenceFlow id="Flow_O_Lap" sourceRef="Gateway_ForkProvisioning" targetRef="Task_SetupPayroll" />
    <bpmn:sequenceFlow id="Flow_O_Pay" sourceRef="Gateway_ForkProvisioning" targetRef="Task_ProvisionLaptop" />
    <bpmn:sequenceFlow id="Flow_O_AcctDone" sourceRef="Task_CreateAccounts" targetRef="Gateway_JoinProvisioning" />
    <bpmn:sequenceFlow id="Flow_O_LapDone" sourceRef="Task_ProvisionLaptop" targetRef="Gateway_JoinProvisioning" />
    <bpmn:sequenceFlow id="Flow_O_PayDone" sourceRef="Task_SetupPayroll" targetRef="Gateway_JoinProvisioning" />
    <bpmn:sequenceFlow id="Flow_O_JoinToWelcome" sourceRef="Gateway_JoinProvisioning" targetRef="Task_SendWelcome" />
    <bpmn:sequenceFlow id="Flow_O_WelcomeToEnd" sourceRef="Task_SendWelcome" targetRef="End_Onboarding" />
    <bpmn:sequenceFlow id="Flow_O_SLA_Acct" sourceRef="BoundaryTimer_Accounts" targetRef="Task_EscalateProvisioning" />
    <bpmn:sequenceFlow id="Flow_O_SLA_Lap" sourceRef="BoundaryTimer_Laptop" targetRef="Task_EscalateProvisioning" />
    <bpmn:sequenceFlow id="Flow_O_SLA_Pay" sourceRef="BoundaryTimer_Payroll" targetRef="Task_EscalateProvisioning" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Onboarding">
    <bpmndi:BPMNPlane id="Plane_Onboarding" bpmnElement="Process_EmployeeOnboarding_1768881387">
      <bpmndi:BPMNShape id="Lane_IT_di" bpmnElement="Lane_IT" isHorizontal="true">
        <dc:Bounds x="120" y="420" width="1550" height="460" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Manager_di" bpmnElement="Lane_Manager" isHorizontal="true">
        <dc:Bounds x="120" y="250" width="1550" height="170" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_HR_di" bpmnElement="Lane_HR" isHorizontal="true">
        <dc:Bounds x="120" y="80" width="1550" height="170" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Onboarding_di" bpmnElement="Start_Onboarding">
        <dc:Bounds x="170" y="132" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="143" y="168" width="90" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
