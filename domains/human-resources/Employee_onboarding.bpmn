        <di:waypoint x="850" y="330" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_O_RejectEnd_di" bpmnElement="Flow_O_RejectEnd">
        <di:waypoint x="1060" y="330" />
        <di:waypoint x="1202" y="330" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_O_Approve_di" bpmnElement="Flow_O_Approve">
        <di:waypoint x="765" y="355" />
        <di:waypoint x="765" y="415" />
