      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CreateAccounts_di" bpmnElement="Task_CreateAccounts">
        <dc:Bounds x="950" y="450" width="210" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ProvisionLaptop_di" bpmnElement="Task_ProvisionLaptop">
        <dc:Bounds x="950" y="540" width="210" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SetupPayroll_di" bpmnElement="Task_SetupPayroll">
        <dc:Bounds x="958" y="731" width="210" height="80" />
