      <bpmndi:BPMNShape id="Task_EscalateProvisioning_di" bpmnElement="Task_EscalateProvisioning">
        <dc:Bounds x="1385" y="520" width="210" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_JoinProvisioning_di" bpmnElement="Gateway_JoinProvisioning" isMarkerVisible="true">
        <dc:Bounds x="1300" y="495" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1242" y="523" width="75" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SendWelcome_di" bpmnElement="Task_SendWelcome">
        <dc:Bounds x="1225" y="123" width="200" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Onboarding_di" bpmnElement="End_Onboarding">
        <dc:Bounds x="1582" y="145" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1571" y="181" width="59" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BoundaryTimer_Payroll_di" bpmnElement="BoundaryTimer_Payroll">
